# Porta do Servidor Express (Render injeta PORT automaticamente)
PORT=3000

# Ambiente: development | production
NODE_ENV=production

# String de Conexão com o Neon DB (PostgreSQL)
# Obtenha no painel do Neon DB: Dashboard > Connection Details > Connection string
# IMPORTANTE: sem &channel_binding=require (pg não suporta, gera warning)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Acesso admin (login + token) ---
# Gere o hash com: node scripts/generate-admin-hash.js "sua-senha-forte"
# NUNCA commite senha nem hash — defina via env local (.env) e no Render.
ADMIN_USER=nix
ADMIN_PASS_HASH=saltHex:hashHex
JWT_SECRET=troque-por-valor-aleatorio-longo